# Variable names only. Put real values in the Posit Connect "Vars" panel,
# or in a local .env file for testing (.env is git-ignored). Never commit values.

# --- Job: switches ---
COMPLIANCE_SCAN_ENABLED=false
BLOCKING_ENABLED=false
EMAIL_ENABLED=true
DRY_RUN=false
# Excluded / enforce-only apps are managed in the dashboard's Admin tab (stored in the database).

# --- Job: identity of this Connect instance ---
COMPLIANCE_INSTANCE=
CONNECT_SERVER=
COMPLIANCE_CONNECT_API_KEY=

# --- Job: policy ---
ALLOWED_GIT_ORGS=
ALLOWED_GIT_HOST=github.com
ORG_DISPLAY_NAME=
REQUIRED_BRANCH=main
GRACE_PERIOD_VALUE=
GRACE_PERIOD_UNIT=days
RELOCK_WINDOW_HOURS=4
LOCK_MESSAGE=

# --- Job: database ---
DATABASE_URL=
DB_SCHEMA=posit_compliance

# --- Job: email ---
SMTP_HOST=
SMTP_PORT=25
SMTP_SENDER=
SMTP_SENDER_NAME=
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
ADMIN_EMAILS=

# --- Dashboard ---
DASHBOARD_DATABASE_URL=
# Administrator key, needed only for Lock / Unlock in the Admin tab
COMPLIANCE_CONNECT_API_KEY=
DASHBOARD_ALLOWED_USERS=
DASHBOARD_ALLOWED_GROUPS=
SQL_TIMEOUT_SECONDS=30
SQL_MAX_ROWS=5000
