# Secrets / local configuration - never commit
.env
.env.*
!.env.example
*.pem
*.key

# Posit publishing metadata (contains server URLs and deployment IDs).
# job/manifest.json and dashboard/manifest.json ARE committed: Git-backed
# deployment needs them, and they contain no server details.
.posit/
rsconnect/
rsconnect-python/

# Generated output
email_previews/
compliance_job.html
compliance_job_files/
.quarto/
*.log

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
